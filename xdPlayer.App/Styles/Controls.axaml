<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:xdPlayer.App.Views">

<Style Selector="views|TrackCardView Border.trackCard">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Transitions">
        <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
    </Setter>
</Style>

<Style Selector="views|TrackCardView Border.trackCard:pointerover">
    <Setter Property="Background" Value="#363636"/>
</Style>

<Style Selector="Border.trackCard:pointerover">
    <Setter Property="Background" Value="#363636"/>
</Style>

<Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
</Style>


    <Style Selector="Border#CoverPlayBorder:pointerover Border#CoverPlayOverlay">
        <Setter Property="Background" Value="#66000000"/>
    </Style>


    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
</Style>

<Style Selector="Slider:horizontal /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
</Style>

    <Style Selector="Border#CoverPlayBorder:pointerover Border#PlayButtonCircle">
        <Setter Property="Opacity" Value="1"/>
    </Style>

<Style Selector="Button.iconButton.selected /template/ Border">
    <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
</Style>

    <!-- ============ SIDEBAR ============ -->

    <!-- Clickable row button that looks like a flat list item -->
<Style Selector="Border.sidebarRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Transitions">
        <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
    </Setter>
</Style>

<Style Selector="Border.sidebarRow.selected">
    <Setter Property="Background" Value="{StaticResource SidebarRestBrush}"/>
</Style>

<Style Selector="Border.sidebarRow.selected:pointerover">
    <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
</Style>

<Style Selector="Border.sidebarRow:pointerover">
    <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
</Style>

    <!-- Playlist ListBoxItem -->
    <Style Selector="ListBox.playlistList">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

<Style Selector="ListBox.playlistList ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Transitions">
        <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
    </Setter>
</Style>

    <Style Selector="ListBox.playlistList ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
    </Style>

    <Style Selector="ListBox.playlistList ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
    </Style>


<Style Selector="Border#CoverHoverBorder:pointerover Border#CoverOverlay">
    <Setter Property="Background" Value="#40000000"/>
</Style>

<Style Selector="Border#PlaylistCoverHoverBorder:pointerover Border#PlaylistCoverOverlay">
    <Setter Property="Background" Value="#40000000"/>
</Style>

<Style Selector="Button.periodButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
</Style>

<Style Selector="Button.periodButton.active">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
</Style>


    <!-- Small icon button (e.g. "+" add playlist) -->
<Style Selector="Button.iconButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
        <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                <Border.Transitions>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    </Transitions>
                </Border.Transitions>
                <ContentPresenter Content="{TemplateBinding Content}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
    </Setter>
</Style>

    <Style Selector="Button.iconButton:pointerover /template/ Border">
        <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
    </Style>

    <!-- User footer -->
    <Style Selector="Border.userFooter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.userFooter:pointerover">
        <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
    </Style>

    <!-- ============ CONTEXT MENU ============ -->

<Style Selector="ContextMenu">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="4"/>
</Style>

<Style Selector="MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="10,6"/>
</Style>

<Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
</Style>

<Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}"/>
</Style>

    <!-- ============ TRACK LIST (Playlist rows) ============ -->

<Style Selector="ListBox.trackList">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
</Style>

<Style Selector="ListBox.trackList ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
</Style>

<Style Selector="ListBox.trackList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="ListBox.trackList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
</Style>

<Style Selector="Border.trackRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Transitions">
        <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
    </Setter>
</Style>

<Style Selector="Border.trackRow:pointerover">
    <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
</Style>

</Styles>