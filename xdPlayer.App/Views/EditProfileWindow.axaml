<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="xdPlayer.App.Views.EditProfileWindow"
        Title="Edit Profile"
        Width="340" Height="380"
        CanResize="False"
        Icon="avares://xdPlayer.App/Assets/xdPlayer.ico"
        Background="{StaticResource SidebarBackgroundBrush}">

    <StackPanel Margin="24" Spacing="16">

        <TextBlock Text="Edit Profile"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>

        <Border Width="100" Height="100"
                CornerRadius="50"
                Background="{StaticResource SurfaceBrush}"
                ClipToBounds="True"
                Cursor="Hand"
                HorizontalAlignment="Center"
                PointerPressed="OnAvatarPointerPressed">
            <Image Name="AvatarPreview" Stretch="UniformToFill"/>
        </Border>

        <TextBlock Text="Click avatar to change"
                   FontSize="11" Opacity="0.5"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource TextBrush}"/>

        <StackPanel Spacing="6">
            <TextBlock Text="Display name" FontSize="12" Opacity="0.6" Foreground="{StaticResource TextBrush}"/>
            <TextBox Name="NameTextBox"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancelClick"
                    Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0"/>
            <Button Content="Save" Click="OnSaveClick"
                    Background="{StaticResource SidebarSelectedBrush}" Foreground="{StaticResource TextBrush}"
                    CornerRadius="4" Padding="14,6"/>
        </StackPanel>

    </StackPanel>

</Window>