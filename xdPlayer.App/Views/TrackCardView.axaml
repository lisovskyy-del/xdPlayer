<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:entities="using:xdPlayer.Domain.Entities"
             x:Class="xdPlayer.App.Views.TrackCardView"
             x:DataType="entities:Track">

<Border x:Name="Card"
        Width="170"
        Padding="8"
        Margin="4"
        CornerRadius="12"
        Background="{DynamicResource CardBrush}"
        BoxShadow="0 4 16 0 #33000000"
        PointerPressed="OnPointerPressed"
        DoubleTapped="OnDoubleTapped">

<Border.ContextMenu>

    <ContextMenu Opening="OnContextMenuOpening">

        <MenuItem Header="Add to playlist" x:Name="AddToPlaylistMenuItem">
            <MenuItem Header="No playlists" IsEnabled="False"/>
        </MenuItem>

        <MenuItem Header="Change cover..." Click="OnChangeCoverClick"/>

        <Separator/>

        <MenuItem Header="Delete" Click="OnDeleteClick"/>

    </ContextMenu>

</Border.ContextMenu>

    <StackPanel Spacing="8">

<!-- Cover -->
<Border Height="150"
        CornerRadius="8"
        Background="#404040"
        ClipToBounds="True">

    <Grid>

<Border x:Name="CoverPlayBorder"
        Background="Transparent"
        Cursor="Hand"
        DoubleTapped="OnCoverPlayDoubleTapped"
        PointerPressed="OnCoverPlayPointerPressed"
        PointerEntered="OnCoverPlayPointerEntered"
        PointerExited="OnCoverPlayPointerExited">

    <Grid>

        <Image Stretch="UniformToFill"
               Source="{Binding CoverImagePath,
                        Converter={StaticResource CoverConverter}}"/>

<Border x:Name="CoverPlayOverlay"
        Background="#00000000"
        IsHitTestVisible="False">
    <Border.Transitions>
        <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
    </Border.Transitions>
</Border>

        <Border x:Name="PlayButtonCircle"
                Width="48"
                Height="48"
                CornerRadius="24"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Border.Transitions>

            <Polygon Points="0,0 16,8 0,16"
                     Fill="#1E1E1E"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="3,0,0,0"/>

        </Border>

    </Grid>

</Border>
    </Grid>

</Border>

        <!-- Title -->
        <TextBlock Text="{Binding Title}"
                   FontWeight="SemiBold"
                   FontSize="15"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1"/>

        <!-- Artist -->
        <TextBlock Text="{Binding Artist}"
                   FontSize="13"
                   Opacity="0.65"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1"/>

    </StackPanel>

</Border>

</UserControl>