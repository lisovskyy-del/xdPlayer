<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xdPlayer.App.ViewModels"
             xmlns:entities="using:xdPlayer.Domain.Entities"
             x:Class="xdPlayer.App.Views.SidebarView"
             x:DataType="vm:SidebarViewModel">

    <Border Background="{StaticResource SidebarBackgroundBrush}"
            Width="240">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"
              Margin="12,16,12,12">

            <!-- LOGO -->
            <TextBlock Grid.Row="0"
                       Text="xdPlayer"
                       FontSize="15"
                       FontWeight="Normal"
                       Foreground="{StaticResource TextBrush}"
                       Margin="6,0,0,16"/>

<!-- ALL TRACKS -->
<Border Grid.Row="1"
        Classes="sidebarRow selected"
        Cursor="Hand"
        PointerPressed="OnAllTracksPointerPressed"
        Margin="0,0,6,16">

    <Grid ColumnDefinitions="*,Auto">

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock Text="♫" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Text="All Tracks"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <Button Grid.Column="1"
                Classes="iconButton"
                Width="28"
                Height="28">
            <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="Add file(s)" Click="OnAddFileClick"/>
                    <MenuItem Header="Add folder" Click="OnAddFolderClick"/>
                </MenuFlyout>
            </Button.Flyout>
            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
        </Button>

    </Grid>

</Border>

            <!-- PLAYLISTS SECTION HEADER -->
<Grid Grid.Row="2"
      ColumnDefinitions="*,Auto"
      Margin="5,4,6,8">

    <TextBlock Grid.Column="0"
               Text="PLAYLISTS"
               FontSize="11"
               FontWeight="Bold"
               Foreground="{StaticResource TextMutedBrush}"
               VerticalAlignment="Center"/>

    <Button Grid.Column="1"
            Classes="iconButton"
            Width="28"
            Height="28"
            Command="{Binding ToggleAddPlaylistCommand}"
            ToolTip.Tip="New playlist">
        <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
    </Button>

</Grid>

            <!-- PLAYLISTS LIST -->
            <Grid Grid.Row="3"
                  RowDefinitions="Auto,*">

                <!-- Inline "new playlist" input -->
                <Border Grid.Row="0"
                        IsVisible="{Binding IsAddingPlaylist}"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6"
                        Margin="0,0,0,6"
                        Padding="8,6">

                    <StackPanel Spacing="6">

                        <TextBox Text="{Binding NewPlaylistName}"
                                 Watermark="Playlist name"
                                 Name="NewPlaylistTextBox"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Right">

                            <Button Content="Create"
                                    Command="{Binding ConfirmAddPlaylistCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White"
                                    CornerRadius="4"
                                    Padding="10,4"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <ListBox Grid.Row="1"
                         Classes="playlistList"
                         ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist}">

                    <ListBox.ItemTemplate>
<DataTemplate x:DataType="entities:Playlist">

    <Grid Height="60"
          ColumnDefinitions="48,*"
          Margin="10,0"
          Background="Transparent">

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Change cover..." Click="OnChangePlaylistCoverClick"/>
                <Separator/>
                <MenuItem Header="Delete playlist" Click="OnDeletePlaylistClick"/>
            </ContextMenu>
        </Grid.ContextMenu>

<Border Grid.Column="0"
        x:Name="SidebarPlaylistCoverBorder"
        Width="48"
        Height="48"
        CornerRadius="6"
        Background="{StaticResource SurfaceBrush}"
        ClipToBounds="True"
        Cursor="Hand"
        PointerPressed="OnSidebarPlaylistCoverPointerPressed"
        PointerEntered="OnSidebarPlaylistCoverPointerEntered"
        PointerExited="OnSidebarPlaylistCoverPointerExited"
        VerticalAlignment="Center">

            <Grid>

                <Image Source="{Binding CoverImagePath,
                                Converter={StaticResource CoverConverter}}"
                       Stretch="UniformToFill"/>

                <Border x:Name="SidebarPlaylistCoverOverlay"
                        Background="#00000000"
                        IsHitTestVisible="False">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12"/>
                        </Transitions>
                    </Border.Transitions>
                </Border>

                <Polygon Points="0,0 8,4 0,8"
                         Fill="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="1,0,0,0"
                         Opacity="0"
                         Name="SidebarPlaylistPlayIcon"
                         IsHitTestVisible="False">
                    <Polygon.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                        </Transitions>
                    </Polygon.Transitions>
                </Polygon>

            </Grid>

        </Border>

        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="2">

            <TextBlock Text="{Binding Name}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="{Binding PlaylistTracks.Count, StringFormat='{}{0} tracks'}"
                       FontSize="12"
                       Opacity="0.6"
                       Foreground="{StaticResource TextBrush}"/>

        </StackPanel>

    </Grid>

</DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

<Border Grid.Row="4"
        Height="1"
        Background="{StaticResource DividerBrush}"
        Margin="6,8,6,8"/>

<!-- user footer -->
<Border Grid.Row="5"
        Classes="userFooter"
        Cursor="Hand"
        PointerPressed="OnUserFooterPointerPressed"
        Margin="0,4,0,0"
        Padding="10,10">
    <Grid ColumnDefinitions="Auto,*,Auto">

        <Border Grid.Column="0"
                Width="36" Height="36"
                CornerRadius="18"
                Background="{StaticResource SurfaceBrush}"
                ClipToBounds="True">
            <Image Source="{Binding ProfileAvatarPath, Converter={StaticResource CoverConverter}}"
                   Stretch="UniformToFill"/>
        </Border>

        <StackPanel Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="1">

            <TextBlock Text="{Binding ProfileDisplayName}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="View profile"
                       FontSize="11"
                       Opacity="0.6"
                       Foreground="{DynamicResource AccentBrush}"/>

        </StackPanel>

        <TextBlock Grid.Column="2"
                   Text="›"
                   FontSize="18"
                   Opacity="0.4"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AccentBrush}"/>

    </Grid>
</Border>

<Border Grid.Row="6"
        Classes="sidebarRow"
        Cursor="Hand"
        PointerPressed="OnSettingsRowPointerPressed"
        Margin="0,4,0,0">

    <StackPanel Orientation="Horizontal"
                Spacing="10"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
        <Viewbox Width="14" Height="14">
            <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                  Fill="{DynamicResource AccentBrush}"/>
        </Viewbox>
        <TextBlock Text="Settings"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextMutedBrush}"/>
    </StackPanel>

</Border>

        </Grid>

    </Border>

</UserControl>