<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xdPlayer.App.ViewModels"
             xmlns:entities="using:xdPlayer.Domain.Entities"
             x:Class="xdPlayer.App.Views.SidebarView"
             x:DataType="vm:SidebarViewModel">

    <Border Background="{StaticResource SidebarBackgroundBrush}"
            Width="240">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
              Margin="12,16,12,12">

            <!-- LOGO -->
            <TextBlock Grid.Row="0"
                       Text="xdPlayer"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       Margin="6,0,0,16"/>

            <!-- ALL TRACKS -->
<!-- ALL TRACKS -->
<Button Grid.Row="1"
        Classes="sidebarRow"
        Classes.selected="{Binding IsLibrarySelected}"
        Command="{Binding ShowLibraryCommand}"
        HorizontalAlignment="Stretch"
        Margin="0,0,0,16">
    <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="🎵" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock Text="All Tracks"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"/>
    </StackPanel>
</Button>

            <!-- PLAYLISTS SECTION HEADER -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  Margin="6,4,6,8">

                <TextBlock Grid.Column="0"
                           Text="PLAYLISTS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextSubtleBrush}"
                           VerticalAlignment="Center"/>

<!-- add button -->
<Button Grid.Column="1"
        Classes="iconButton"
        Command="{Binding ToggleAddPlaylistCommand}"
        ToolTip.Tip="New playlist">
    <TextBlock Text="＋" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
</Button>

            </Grid>

            <!-- PLAYLISTS LIST -->
            <Grid Grid.Row="3"
                  RowDefinitions="Auto,*">

                <!-- Inline "new playlist" input -->
                <Border Grid.Row="0"
                        IsVisible="{Binding IsAddingPlaylist}"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="6"
                        Margin="0,0,0,6"
                        Padding="8,6">

                    <StackPanel Spacing="6">

                        <TextBox Text="{Binding NewPlaylistName}"
                                 Watermark="Playlist name"
                                 Name="NewPlaylistTextBox"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Right">

                            <Button Content="Create"
                                    Command="{Binding ConfirmAddPlaylistCommand}"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="White"
                                    CornerRadius="4"
                                    Padding="10,4"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <ListBox Grid.Row="1"
                         Classes="playlistList"
                         ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist}">

                    <ListBox.ItemTemplate>
<DataTemplate x:DataType="entities:Playlist">

    <Grid Height="60"
          ColumnDefinitions="48,*"
          Margin="10,0">

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Delete playlist" Click="OnDeletePlaylistClick"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Border Grid.Column="0"
                Width="48"
                Height="48"
                CornerRadius="6"
                Background="{StaticResource SurfaceBrush}"
                ClipToBounds="True"
                VerticalAlignment="Center">

            <Image Source="{Binding CoverImagePath,
                            Converter={StaticResource CoverConverter}}"
                   Stretch="UniformToFill"/>

        </Border>

        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="2">

            <TextBlock Text="{Binding Name}"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="{Binding PlaylistTracks.Count, StringFormat='{}{0} tracks'}"
                       FontSize="12"
                       Opacity="0.6"
                       Foreground="{StaticResource TextBrush}"/>

        </StackPanel>

    </Grid>

</DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

<!-- user footer -->
<Border Grid.Row="4" Classes="userFooter" Margin="0,12,0,0" Padding="8">
    <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="28" Height="28" CornerRadius="14"
                Background="{StaticResource SurfaceBrush}"/>
        <TextBlock Text="User" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
    </StackPanel>
</Border>

        </Grid>

    </Border>

</UserControl>