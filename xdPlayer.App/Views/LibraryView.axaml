<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xdPlayer.App.ViewModels"
             xmlns:entities="using:xdPlayer.Domain.Entities"
             xmlns:views="using:xdPlayer.App.Views"
             x:Class="xdPlayer.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

<Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- Search row -->
    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          Margin="24,20,24,16">

        <Grid Grid.Column="0"
              MaxWidth="500"
              HorizontalAlignment="Stretch">

            <TextBox Text="{Binding SearchQuery}"
                     PlaceholderText="Search tracks..."
                     Background="{StaticResource SearchFieldBrush}"
                     BorderBrush="{StaticResource DividerBrush}"
                     BorderThickness="1"
                     CornerRadius="8"
                     Padding="10,12,36,10"
                     FontSize="15"
                     Foreground="{StaticResource TextBrush}"/>

            <TextBlock Text="🔍"
                       FontSize="14"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,12,0"
                       IsHitTestVisible="False"/>

        </Grid>

<StackPanel Grid.Column="1"
            Orientation="Horizontal"
            Spacing="4"
            Margin="12,0,0,0">

    <Button Classes="iconButton"
            Classes.selected="{Binding IsGridView}"
            Command="{Binding SetGridViewCommand}"
            Width="44" Height="44">
        <TextBlock Text="⊞" FontSize="22"/>
    </Button>

    <Button Classes="iconButton"
            Classes.selected="{Binding !IsGridView}"
            Command="{Binding SetListViewCommand}"
            Width="44" Height="44">
        <TextBlock Text="☰" FontSize="22"/>
    </Button>

</StackPanel>

    </Grid>

    <!-- Divider -->
    <Border Grid.Row="1"
            Height="1"
            Background="{StaticResource DividerBrush}"
            Margin="24,0,24,0"/>

    <!-- Title row -->
    <StackPanel Grid.Row="2"
                Margin="24,16,24,20"
                Spacing="2">
        <TextBlock Text="All Tracks"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="{Binding TracksCountText}"
                   FontSize="13"
                   Opacity="0.6"
                   Foreground="{StaticResource TextBrush}"/>
    </StackPanel>

<ScrollViewer Grid.Row="3"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">

    <Grid>

        <!-- Grid mode -->
        <ItemsControl ItemsSource="{Binding Tracks}"
                      HorizontalAlignment="Center"
                      IsVisible="{Binding IsGridView}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>

                <DataTemplate x:DataType="entities:Track">

                    <views:TrackCardView
                        Margin="10"
                        DataContext="{Binding}"/>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- List mode -->
        <ListBox Classes="trackList"
                 Margin="24,0,24,20"
                 ItemsSource="{Binding Tracks}"
                 IsVisible="{Binding !IsGridView}">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="entities:Track">

                    <Border Classes="trackRow" Padding="10">

                        <Grid ColumnDefinitions="48,*,160,70"
                              DoubleTapped="OnListTrackDoubleTapped"
                              PointerPressed="OnGridPointerPressed"
                              Background="Transparent">

                            <Grid.ContextMenu>
                                <ContextMenu Opening="OnListContextMenuOpening">
                                    <MenuItem Header="Add to playlist"/>
                                    <MenuItem Header="Change cover..." Click="OnListChangeCoverClick"/>
                                    <Separator/>
                                    <MenuItem Header="Delete" Click="OnListDeleteClick"/>
                                </ContextMenu>
                            </Grid.ContextMenu>

<Border Grid.Column="0"
        x:Name="ListCoverPlayBorder"
        Width="40" Height="40"
        CornerRadius="4"
        Background="#444"
        ClipToBounds="True"
        Cursor="Hand"
        PointerPressed="OnListCoverPlayPointerPressed"
        PointerEntered="OnListCoverPlayPointerEntered"
        PointerExited="OnListCoverPlayPointerExited">

    <Grid>

        <Image Source="{Binding CoverImagePath,
                        Converter={StaticResource CoverConverter}}"
               Stretch="UniformToFill"/>

        <Border x:Name="ListCoverPlayOverlay"
                Background="#00000000"
                IsHitTestVisible="False">
            <Border.Transitions>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Border.Transitions>
        </Border>

        <Polygon x:Name="ListPlayIcon"
                 Points="0,0 10,5 0,10"
                 Fill="White"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="1,0,0,0"
                 Opacity="0"
                 IsHitTestVisible="False">
            <Polygon.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Polygon.Transitions>
        </Polygon>

    </Grid>

</Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Text="{Binding Artist}"
                                       Opacity="0.7"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Text="{Binding DurationSeconds,
                                       Converter={StaticResource DurationConverter}}"/>

                        </Grid>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</ScrollViewer>

</Grid>

</UserControl>