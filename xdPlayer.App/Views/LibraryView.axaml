<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xdPlayer.App.ViewModels"
             xmlns:entities="using:xdPlayer.Domain.Entities"
             xmlns:views="using:xdPlayer.App.Views"
             x:Class="xdPlayer.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

<Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- Search row -->
    <Grid Grid.Row="0"
          ColumnDefinitions="*,Auto"
          Margin="24,20,24,16">

        <Grid Grid.Column="0"
              MaxWidth="500"
              HorizontalAlignment="Stretch">

            <TextBox Text="{Binding SearchQuery}"
                     PlaceholderText="Search tracks..."
                     Background="{StaticResource SearchFieldBrush}"
                     BorderBrush="{StaticResource DividerBrush}"
                     BorderThickness="1"
                     CornerRadius="8"
                     Padding="14,10,36,10"
                     Foreground="{StaticResource TextBrush}"/>

            <TextBlock Text="🔍"
                       FontSize="14"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,12,0"
                       IsHitTestVisible="False"/>

        </Grid>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="12,0,0,0">

            <Button Classes="iconButton" Width="44" Height="44">
                <TextBlock Text="⊞" FontSize="22"/>
            </Button>

            <Button Classes="iconButton" Width="44" Height="44">
                <TextBlock Text="☰" FontSize="22"/>
            </Button>

        </StackPanel>

    </Grid>

    <!-- Divider -->
    <Border Grid.Row="1"
            Height="1"
            Background="{StaticResource DividerBrush}"
            Margin="24,0,24,0"/>

    <!-- Title row -->
    <StackPanel Grid.Row="2"
                Margin="24,16,24,20"
                Spacing="2">
        <TextBlock Text="All Tracks"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="{Binding TracksCountText}"
                   FontSize="13"
                   Opacity="0.6"
                   Foreground="{StaticResource TextBrush}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="3"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">

        <ItemsControl ItemsSource="{Binding Tracks}"
                      HorizontalAlignment="Center">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"
                               HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>

                <DataTemplate x:DataType="entities:Track">

                    <views:TrackCardView
                        Margin="10"
                        DataContext="{Binding}"/>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </ScrollViewer>

</Grid>

</UserControl>