<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:xdPlayer.App.ViewModels"
             x:Class="xdPlayer.App.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <ScrollViewer>

        <StackPanel Margin="32,28" Spacing="24">

            <!-- Header -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="12"
                    Padding="24">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Ellipse Grid.Column="0"
                             Width="80" Height="80"
                             Fill="{StaticResource SurfaceBrush}"/>

                    <StackPanel Grid.Column="1"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="4">

                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="{Binding MemberSince}"
                                   FontSize="13"
                                   Opacity="0.6"
                                   Foreground="{StaticResource TextBrush}"/>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Edit Profile"
                            Background="{StaticResource SurfaceBrush}"
                            Foreground="{StaticResource TextBrush}"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="14,8"
                            VerticalAlignment="Center"/>

                </Grid>

            </Border>

            <!-- Stats cards -->
            <UniformGrid Columns="5" Rows="1">

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Margin="0,0,8,0"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TracksInLibrary}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Tracks in library"
                                   FontSize="12" Opacity="0.6"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Margin="0,0,8,0"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding LikedTracksCount}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Liked tracks"
                                   FontSize="12" Opacity="0.6"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Margin="0,0,8,0"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding TotalPlayTimeText}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Total play time"
                                   FontSize="12" Opacity="0.6"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Margin="0,0,8,0"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding DaysListened}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Days listened"
                                   FontSize="12" Opacity="0.6"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding MostPlayedGenre}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Most played genre"
                                   FontSize="12" Opacity="0.6"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Placeholder for future sections -->
            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="12"
                    Padding="24">
                <TextBlock Text="Top 10 Tracks and activity chart coming soon..."
                           Opacity="0.5"
                           Foreground="{StaticResource TextBrush}"/>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>